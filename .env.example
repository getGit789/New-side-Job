# Copy to .env and edit. Every variable has a safe default except BRIEFRELAY_BASE_URL in production.
BRIEFRELAY_ENV=production            # production | development | demo
BRIEFRELAY_ADDR=127.0.0.1:8080       # bind address; put a TLS reverse proxy in front
BRIEFRELAY_BASE_URL=https://portal.example.com
BRIEFRELAY_DATA_DIR=./data           # holds app.db and files/ ; keep it outside the web root and back it up
BRIEFRELAY_TRUST_PROXY=false         # true only when a reverse proxy sets X-Forwarded-For
BRIEFRELAY_LOG_LEVEL=info            # debug | info | warn | error
BRIEFRELAY_MAX_UPLOAD_MB=50

# Outbound mail. Leave SMTP_HOST empty to log mail instead of sending (development/demo).
BRIEFRELAY_SMTP_HOST=
BRIEFRELAY_SMTP_PORT=587
BRIEFRELAY_SMTP_USER=
BRIEFRELAY_SMTP_PASS=
BRIEFRELAY_MAIL_FROM=BriefRelay <no-reply@example.com>
